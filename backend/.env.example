# Backend Environment Configuration
APP_ENV=development
DEBUG=true

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securelife
POSTGRES_PORT=5432
# When running with backend/docker-compose.yml:
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/securelife
# When running locally on host machine (connecting to exposed PostgreSQL port):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/securelife

# LLM Configuration (options: mock, groq, openai)
LLM_PROVIDER=mock
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_CHAT_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Lead Qualification Settings
QUALIFICATION_THRESHOLD=50
SLOT_CONFIRMATION_REQUIRED=false

# Security & CORS
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
